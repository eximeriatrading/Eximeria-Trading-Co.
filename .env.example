# ---- SMTP used to deliver contact-form enquiries ----
# Gmail: enable 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and paste it in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=teameximeriatrading@gmail.com
SMTP_PASS=your-app-password

# Inbox that receives enquiries (comma-separate for several)
CONTACT_TO=teameximeriatrading@gmail.com
# "From" shown on outgoing mail (must be allowed by your SMTP provider)
CONTACT_FROM="Eximeria Trading Co. <teameximeriatrading@gmail.com>"

# Send the enquirer an automatic "we received your enquiry" email (true/false)
SEND_AUTO_REPLY=true
